{
  "name": "@rljson/fs-agent",
  "version": "0.2.2",
  "description": "Rljson fs-agent description",
  "homepage": "https://github.com/rljson/fs-agent",
  "bugs": "https://github.com/rljson/fs-agent/issues",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rljson/fs-agent.git"
  },
  "main": "dist/fs-agent.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm exec vite build && tsc && node scripts/copy-readme-to-dist.js",
    "test": "cross-env NODE_OPTIONS=--max-old-space-size=8192 pnpm exec vitest run --coverage --no-file-parallelism && pnpm run lint",
    "prebuild": "npm run test",
    "prepublishOnly": "npm run build",
    "lint": "pnpm exec eslint .",
    "updateGoldens": "cross-env UPDATE_GOLDENS=true pnpm test"
  },
  "devDependencies": {
    "@rljson/dna-rljson": "0.2.0",
    "@rljson/server": "0.0.77",
    "@tssuite/helix-js": "0.4.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitest/coverage-v8": "^5.0.5",
    "cross-env": "^10.1.0",
    "eslint": "~10.13.0",
    "eslint-plugin-jsdoc": "^65.3.15",
    "eslint-plugin-tsdoc": "^0.5.4",
    "globals": "^17.13.0",
    "jsdoc": "^4.0.5",
    "read-pkg": "^10.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-node": "^6.0.0",
    "vite-plugin-dts": "^5.1.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5",
    "vitest-dom": "^0.1.1"
  },
  "dependencies": {
    "@rljson/bs": "0.0.29",
    "@rljson/db": "0.1.1",
    "@rljson/hash": "0.0.19",
    "@rljson/io": "0.0.85",
    "@rljson/json": "0.0.23",
    "@rljson/rljson": "0.0.86",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@rljson/bs": "0.0.29",
      "@rljson/db": "0.1.1",
      "@rljson/hash": "0.0.19",
      "@rljson/io": "0.0.85",
      "@rljson/json": "0.0.23",
      "@rljson/rljson": "0.0.86",
      "@rljson/server": "0.0.76"
    }
  },
  "packageManager": "pnpm@10.11.0"
}
